{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "timezone": "UTC",
  "schedule": ["at any time"],
  "labels": ["dependencies"],
  "baseBranchPatterns": ["develop"],
  "prConcurrentLimit": 10,
  "prCreation": "immediate",
  "packageRules": [
    {
      "groupName": "ardalis-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Ardalis\\./"]
    },
    {
      "groupName": "aspire-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Aspire\\./"]
    },
    {
      "groupName": "correlate-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Correlate\\./"]
    },
    {
      "groupName": "fluentvalidation-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^FluentValidation/"]
    },
    {
      "groupName": "fluxor-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Fluxor/"]
    },
    {
      "groupName": "microsoft-aspnetcore-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Microsoft\\.AspNetCore\\./"]
    },
    {
      "groupName": "microsoft-entityframework-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Microsoft\\.EntityFrameworkCore/"]
    },
    {
      "groupName": "microsoft-extensions-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Microsoft\\.Extensions\\./"]
    },
    {
      "groupName": "opentelemetry-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^OpenTelemetry/"]
    },
    {
      "groupName": "refit-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^Refit/"]
    },
    {
      "groupName": "xunit-updates (minor/patch)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/^xunit/"]
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Block major updates for all packages",
      "matchPackageNames": ["/.*/"]
    },
    {
      "enabled": false,
      "description": "FluentAssertions packages should not be upgraded",
      "matchPackageNames": ["/^FluentAssertions/"]
    },
    {
      "enabled": false,
      "description": "MediatR packages should not be upgraded",
      "matchPackageNames": ["/^MediatR/"]
    }
  ]
}