@using Pizzeria.Store.Contracts

@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Lewee.Infrastructure.Fluxor.ClientEventReceiver />

<MudLayout>
    <MudAppBar Elevation="1" role="banner">
        <MudIconButton
            Icon="Icons.Material.Filled.Menu"
            Color="Color.Inherit"
            Edge="Edge.Start" />

        <MudSpacer />

        <MudText
            Typo="Typo.h6"
            role="heading"
            aria-level="1">Lewee Pizzeria</MudText>

        <MudSpacer />

        <MudIconButton
            Icon="@Icons.Material.Filled.Logout"
            aria-label="@MainLayout.AriaLabels.SignOut"
            Color="Color.Inherit"
            OnClick="SignOut" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-16 pt-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
