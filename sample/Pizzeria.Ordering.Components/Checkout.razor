@using Pizzeria.Store.Contracts
@using Pizzeria.Store.Contracts.Orders
@attribute [Route(PageRoutes.CheckoutRoutePattern)]
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inherits FluxorComponent

<PageTitle>Checkout - Pizzeria Store</PageTitle>

@if (OrdersState.Value.Data == null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <MudText>No active order found. <MudLink Href="/" Color="Color.Primary">Start a new order</MudLink></MudText>
    </MudAlert>
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true" role="heading" aria-level="4">
        Checkout
    </MudText>

    <MudRadioGroup T="FulfillmentMethod" Value="this.fulfillmentMethod" ValueChanged="this.OnFulfillmentMethodChanged">
        <MudRadio T="FulfillmentMethod" Value="FulfillmentMethod.Pickup" Color="Color.Primary">Pickup</MudRadio>
        <MudRadio T="FulfillmentMethod" Value="FulfillmentMethod.Delivery" Color="Color.Primary">Delivery</MudRadio>
    </MudRadioGroup>

    @if (this.fulfillmentMethod == FulfillmentMethod.Delivery)
    {
        <MudTextField T="string"
                       Label="Delivery Address"
                       aria-label="@AriaLabels.DeliveryAddress"
                       @bind-Value="this.deliveryAddress"
                       MaxLength="UpdateOrderRequest.DeliveryAddressMaxLength"
                       Immediate="true"
                       Class="mt-4" />
    }

    @if (!string.IsNullOrEmpty(this.validationErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            @this.validationErrorMessage
        </MudAlert>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Large"
               Class="mt-4"
               role="button"
               aria-label="@AriaLabels.SubmitOrder"
               Disabled="OrdersState.Value.IsSaving"
               OnClick="SubmitOrder">
        @if (OrdersState.Value.IsSaving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText Class="ml-2">Submitting...</MudText>
        }
        else
        {
            <MudText>Submit Order</MudText>
        }
    </MudButton>
}

@if (!string.IsNullOrEmpty(OrdersState.Value.ErrorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mt-4"
              ShowCloseIcon="true"
              CloseIconClicked="ClearError">
        @OrdersState.Value.ErrorMessage
    </MudAlert>
}
