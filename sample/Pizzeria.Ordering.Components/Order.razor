@using Pizzeria.Store.Contracts
@using Pizzeria.Store.Contracts.Orders
@attribute [Route(PageRoutes.OrderRoutePattern)]
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inherits FluxorComponent

<PageTitle>Order - Pizzeria Store</PageTitle>

@if (OrdersState.Value.Data == null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <MudText>No active order found. <MudLink Href="/" Color="Color.Primary">Start a new order</MudLink></MudText>
    </MudAlert>
}
else if (OrdersState.Value.Data.Status == OrderStatus.InProgress)
{
    <MudText Typo="Typo.h4" GutterBottom="true" role="heading" aria-level="4">
        Pizza Menu
    </MudText>

    @if (PizzasState.Value.IsLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                        <MudCardContent>
                            <MudSkeleton SkeletonType="SkeletonType.Text" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (PizzasState.Value.Data?.Any() != true)
    {
        <MudAlert Severity="Severity.Info">
            <MudText>No pizzas available at the moment.</MudText>
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var pizza in PizzasState.Value.Data ?? [])
            {
                var quantity = OrdersState.Value.Data.Pizzas.FirstOrDefault(p => p.PizzaId == pizza.Id)?.Quantity ?? 0;

                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h6" GutterBottom="true">
                                @pizza.Name
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                @pizza.Description
                            </MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">
                                $@pizza.Price.ToString("F2")
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Large" Class="flex-grow-1">
                                <MudButton OnClick="() => RemovePizza(pizza.Id)"
                                           Disabled="quantity == 0"
                                           StartIcon="Icons.Material.Filled.Remove">
                                </MudButton>
                                <MudButton Style="min-width: 80px;" Disabled="true">
                                    @quantity
                                </MudButton>
                                <MudButton OnClick="() => AddPizza(pizza.Id)"
                                           StartIcon="Icons.Material.Filled.Add">
                                </MudButton>
                            </MudButtonGroup>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   Class="mt-4"
                   role="button"
                   aria-label="@AriaLabels.Checkout"
                   Disabled="!OrdersState.Value.Data.Pizzas.Any()"
                   OnClick="GoToCheckout">
            Checkout
        </MudButton>
    }
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true" role="heading" aria-level="4">
        Order Status
    </MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" role="status">
            @OrdersState.Value.Data.Status
        </MudText>

        @if (OrdersState.Value.Data.IsDeliveryOrder && !string.IsNullOrEmpty(OrdersState.Value.Data.DeliveryAddress))
        {
            <MudText Typo="Typo.body2" Class="mt-2">
                Delivering to: @OrdersState.Value.Data.DeliveryAddress
            </MudText>
        }
    </MudPaper>

    <MudList T="string">
        @foreach (var pizza in OrdersState.Value.Data.Pizzas)
        {
            <MudListItem T="string">
                @pizza.Quantity x @pizza.PizzaName - $@pizza.LineTotal.ToString("F2")
            </MudListItem>
        }
    </MudList>

    <MudText Typo="Typo.h6" Class="mt-4">
        Total: $@OrdersState.Value.Data.TotalCost.ToString("F2")
    </MudText>
}

@if (!string.IsNullOrEmpty(OrdersState.Value.ErrorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mt-4"
              ShowCloseIcon="true"
              CloseIconClicked="ClearError">
        @OrdersState.Value.ErrorMessage
    </MudAlert>
}

@if (!string.IsNullOrEmpty(PizzasState.Value.ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">
        @PizzasState.Value.ErrorMessage
    </MudAlert>
}
