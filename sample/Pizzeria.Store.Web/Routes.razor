<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(Pizzeria.Store.Components._Imports).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToSignIn />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <MudText Typo="Typo.h4" GutterBottom="true">Page Not Found</MudText>
            <MudText Typo="Typo.body1">Sorry, there's nothing at this address.</MudText>
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Return to Home</MudButton>
        </LayoutView>
    </NotFound>
</Router>
