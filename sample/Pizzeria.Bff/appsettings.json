{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-api": {
        "ClusterId": "auth-api",
        "Order": 0,
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "store-api": {
        "ClusterId": "store-api",
        "Order": 1,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-api": {
        "Destinations": {
          "auth-api": {
            "Address": "https+http://auth-api"
          }
        }
      },
      "store-api": {
        "Destinations": {
          "store-api": {
            "Address": "https+http://pizza-store-api"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
